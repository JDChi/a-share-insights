# Automatically read by backend config; real .env must never be committed.
ASHARE_DATA_DIR=../data
ASHARE_DATABASE_URL=postgresql+psycopg://ashare:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/ashare
ASHARE_HOST=127.0.0.1
ASHARE_PORT=8000
ASHARE_REQUEST_TIMEOUT=30
# Defaults to <data_dir>/models/bge-large-zh-v1.5; no automatic downloads.
# ASHARE_EMBEDDING_MODEL_PATH=/absolute/path/to/bge-large-zh-v1.5
ASHARE_EMBEDDING_BATCH_SIZE=4
ASHARE_CHUNK_SIZE=384
ASHARE_CHUNK_OVERLAP=64
ASHARE_LLM_BASE_URL=https://api.minimax.cn/v1
ASHARE_LLM_MODEL=
ASHARE_LLM_API_KEY=
ASHARE_LLM_TIMEOUT=90
# Empty evaluator fields inherit their LLM equivalents.
ASHARE_EVAL_BASE_URL=
ASHARE_EVAL_MODEL=
ASHARE_EVAL_API_KEY=
